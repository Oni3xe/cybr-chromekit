{
  "name": "chromekit",
  "version": "1.2.0",
  "status": "approved",
  "mode": "dark-only",
  "color": {
    "bg": "#000000",
    "surface.1": "#0D0506",
    "surface.2": "#1A0B0D",
    "scrim": "#D9000000",
    "red.bright": "#FF959B",
    "red": "#FF646D",
    "red.dim": "#B34A51",
    "red.deep": "#3A1619",
    "cyan.bright": "#9FEFF5",
    "cyan": "#66D1D9",
    "cyan.dim": "#42888D",
    "cyan.deep": "#0F2E31",
    "text": "#B8B3B6",
    "text.muted": "#8E888C",
    "disabled": "#55525A",
    "green": "#4CD97B",
    "gold": "#FFC94D",
    "error": "#FF2BD6"
  },
  "role": {
    "background": "bg",
    "border": "red.dim",
    "border.active": "red",
    "divider": "red.deep",
    "command": "red",
    "warning": "red",
    "selected": "cyan",
    "readout": "cyan",
    "ok": "green",
    "special": "gold",
    "error": "error",
    "on.fill": "bg",
    "menu": "red"
  },
  "marker": {
    "warning": "! prefix or CAPS",
    "error": "!! prefix"
  },
  "state": {
    "precedence": ["disabled", "pressed", "focused", "selected", "normal"],
    "normal": {
      "label": "red",
      "fill": "none",
      "frame": "red.dim",
      "frameDp": 1
    },
    "pressed": {
      "label": "bg",
      "fill": "red",
      "frame": "red.bright",
      "glow": {
        "color": "red",
        "strokesDp": [2, 4, 6],
        "alpha": [0.45, 0.25, 0.12],
        "draw": "drawBehind"
      },
      "haptic": "View.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP) on press-down"
    },
    "pressed.decay": {
      "label": "red",
      "fill": "red.deep",
      "frame": "red.dim"
    },
    "focused": {
      "overlay": true,
      "ring": "cyan.bright",
      "ringDp": 2
    },
    "selected": {
      "label": "cyan",
      "fill": "cyan.deep",
      "frame": "cyan"
    },
    "disabled": {
      "label": "disabled",
      "fill": "none",
      "frame": "disabled",
      "frameStyle": "dashed",
      "dashDp": [3, 2],
      "interactive": false
    }
  },
  "motion": {
    "pressLatchMs": 140,
    "pressStepOffMs": 60,
    "pressStepOff": ["red.deep 30ms", "normal 30ms"],
    "panelOpenMs": 120,
    "panelCloseMs": 90,
    "panelEasing": "4 discrete steps",
    "cursorBlinkMs": 530,
    "scanBarSweepMs": 1200,
    "toastMs": 2500,
    "reduceMotion": {
      "source": "system animator duration scale 0, or the in-app switch",
      "disables": ["cursorBlink", "glitch", "scanline", "scanBar", "pressStepOff", "panelAnimation"],
      "keeps": ["pressLatch", "haptic"]
    }
  },
  "type": {
    "ui": "Rajdhani (bundled)",
    "data": {
      "android": "JetBrains Mono (bundled)",
      "tui": "Terminus 8x16"
    },
    "scaleSp": {
      "display": {
        "size": 32,
        "weight": 600,
        "tracking": 2
      },
      "title": {
        "size": 20,
        "weight": 600,
        "tracking": 1
      },
      "header": {
        "size": 16,
        "weight": 600,
        "tracking": 1.5,
        "case": "upper"
      },
      "body": {
        "size": 16,
        "weight": 500,
        "lineHeight": 22
      },
      "section": {
        "size": 14,
        "weight": 600,
        "tracking": 1.5,
        "case": "upper"
      },
      "label": {
        "size": 14,
        "weight": 600,
        "tracking": 1,
        "case": "upper"
      },
      "caption": {
        "size": 12,
        "weight": 500
      },
      "data": {
        "size": 13,
        "family": "data"
      },
      "log": {
        "size": 12,
        "family": "data",
        "lineHeight": 16
      }
    }
  },
  "space": {
    "scaleDp": [4, 8, 12, 16, 24],
    "gutterDp": 12,
    "panelPaddingDp": 12
  },
  "shape": {
    "cornerRadiusDp": 0,
    "borderDp": 1,
    "focusRingDp": 2,
    "buttons": "square",
    "chamfer": {
      "angleDeg": 45,
      "sizeDp": 6,
      "corner": "top-start",
      "appliesTo": ["tab", "panel", "dialog", "toast", "menu"]
    }
  },
  "layout": {
    "header": {
      "heightDp": 48,
      "title": "// APPNAME",
      "titleColor": "red",
      "titleType": "header",
      "status": "cyan label caps, end-aligned (e.g. SYNC OK)",
      "rule": "red.deep 1dp bottom, full width"
    },
    "tabs": {
      "position": "12dp under the header rule, start-aligned",
      "widthDp": 80,
      "gapDp": 8,
      "visualHeightDp": 36,
      "touchHeightDp": 48,
      "paddingHorizontalMinDp": 20,
      "label": "short caps label, centered, no brackets",
      "chamfer": "top-start 6dp",
      "normal": "red label, red.dim frame",
      "selected": "cyan label and frame on cyan.deep",
      "shortLabels": "Each app defines an all-caps short label per tab up front (TIMELINE=TML, DAILY=DAY, MONTHLY=MON). If any full label plus 2x20dp does not fit 80dp, the whole strip uses short labels.",
      "truncation": "never; no ellipsis",
      "accessibility": "contentDescription carries the full name",
      "capacity": "floor((W - 24 + 8) / 88): 3 at 360dp, 4 at 411dp",
      "overflow": "last tab becomes [ ... ] and opens the menu panel"
    },
    "actionBar": {
      "android": "bottom, start-aligned, 16dp above the nav inset, one row only, never wraps, never scrolls, no rule above it",
      "tui": "top, key-hint bar",
      "actionSlotDp": 104,
      "menuSlotDp": 72,
      "gapDp": 8,
      "gutterDp": 12,
      "visualHeightDp": 40,
      "touchHeightDp": 48,
      "capacityNoMenu": "floor((W - 24 + 8) / 112)",
      "capacityWithMenu": "floor((W - 24 - 72) / 112) actions, then [ ... ]",
      "examples": {
        "360dp": "3 actions, or 2 + [ ... ]",
        "411dp": "3 actions, or 2 + [ ... ]",
        "480dp": "4 actions, or 3 + [ ... ]",
        "600dp": "5 actions, or 4 + [ ... ]"
      },
      "overflow": "last slot becomes [ ... ] and opens the menu panel with the remaining actions in declared order",
      "labels": "[ LABEL ] caps; same short-label rule as tabs; no truncation"
    },
    "button": {
      "label": "[ LABEL ]",
      "paddingHorizontalDp": 12,
      "visualHeightDp": 40,
      "touchHeightDp": 48,
      "shape": "square"
    },
    "listRow": {
      "minHeightDp": 64,
      "timeColumnDp": 64,
      "time": "cyan data",
      "title": "text body 16sp",
      "secondary": "text.muted caption",
      "divider": "red.deep 1dp, inset to the gutters",
      "press": "pressed state across the full row"
    },
    "menuPanel": {
      "anchor": "above the [ ... ] button, end edge aligned to it",
      "chamfer": "top-start 6dp",
      "fill": "bg",
      "frame": "red 1dp",
      "rows": "list-row style: 48dp, red label caps, full names, red.deep dividers, full-row press",
      "minWidthDp": 160,
      "close": "on selection, outside tap or back",
      "motion": "panelOpenMs / panelCloseMs"
    },
    "screen": {
      "frame": "red.dim 1dp, upper-left chamfer 6dp",
      "fill": "surface.1",
      "outside": "bg"
    },
    "sectionLabel": {
      "type": "caption caps",
      "color": "text.muted",
      "example": "FRI 20 NOV"
    },
    "notes": {
      "label": "text.muted caption, sentence case",
      "body": "text body"
    },
    "special": {
      "color": "gold",
      "prefix": "* "
    },
    "warning": {
      "color": "red",
      "style": "label caps",
      "prefix": "! "
    }
  },
  "icon": {
    "gridDp": 24,
    "strokeDp": 1.6,
    "cap": "square",
    "join": "miter",
    "fill": "none, except dots under 3dp",
    "color": "tinted by token at runtime; source art stays #FFFFFF"
  },
  "exceptions": {
    "cybr-map": {
      "map.ground": "#06070A",
      "map.park": "#080B0B",
      "map.water": "#040A18",
      "map.waterEdge": "#1C3A5C",
      "map.building": "#7A1824",
      "map.buildingFlat": "#5A1018",
      "map.roadHighway": "#529EA6",
      "map.roadMajor": "#42888D",
      "map.roadMinor": "#1F5358",
      "map.roadPath": "#133034",
      "map.rail": "#34404A",
      "map.navPath": "#7FF4FF",
      "note": "place labels use text, road labels use text.muted, POI labels use cyan"
    },
    "kiroshi-tui": {
      "background": "the terminal profile may override bg"
    },
    "photo-backgrounds": {
      "apps": ["cybr-launcher", "kiroshi-droid"],
      "rule": "text sits on scrim panels; a rare full-bleed label gets a bg halo"
    }
  },
  "enforcement": {
    "pin": "each repo pins its tokens version in chromekit.version",
    "ci": "the repo copy must equal the generated output of its pinned version; raw hex outside the tokens file fails, except named exceptions"
  },
  "textPolicy": {
    "rule": "No white or near-white text. Text is red or gray, plus the cyan, gold, magenta and green roles.",
    "allowedText": ["red", "text", "text.muted", "disabled", "cyan", "cyan.dim", "gold", "error", "green"],
    "neverText": ["red.bright", "cyan.bright", "#FFFFFF"],
    "colorReference": "reference screen (panel B)"
  },
  "referenceScreen": "body-text-compare.png, panel B (layout and colors); tabs add the 6dp upper-left chamfer"
}
